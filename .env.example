# Copy this file to .env and paste your Gemini API key (get one at https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# ----- Optional settings (the defaults are fine) -----

# Model used by the supervisor agent and by the 3 specialist agents
GEMINI_MODEL=gemini-2.5-flash
GEMINI_WORKER_MODEL=gemini-2.5-flash

# "Thinking" tokens cost money. 0 = off. Only used by gemini-2.5 models.
GEMINI_SUPERVISOR_THINKING_BUDGET=512
GEMINI_WORKER_THINKING_BUDGET=0

# How many past questions the AI remembers (fewer = cheaper)
GEMINI_HISTORY_TURNS=4
